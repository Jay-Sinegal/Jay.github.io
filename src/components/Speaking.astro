---
import Icons from "./Icons.astro";
import ShinyButton from "./ShinyButton.astro";

const KEYNOTES = [
  {
    no: "01",
    title: "Being Seen Isn't the Same as Being Remembered",
    subtitle: "The Architecture of Long-Term Brand Memory",
    audience: "Corporate executives · marketing directors · chambers of commerce · entrepreneurs",
    summary:
      "Moves beyond short-lived viral attention into cognitive brand structure. Jaylen demonstrates how businesses build distinctive brand assets, narrative depth, and sustainable market trust across the Gulf Coast.",
  },
  {
    no: "02",
    title: "The Modern Athlete IP Ecosystem & Louisiana Act 810",
    subtitle: "Ethics, Amateurism, and the Future of Sports",
    audience: "High school athletic directors · school boards · head coaches · sports law symposiums",
    summary:
      "Translates Louisiana Act 810 and SB 389 into an actionable institutional defense strategy. Covers protecting student amateur status, insulating campuses from predatory runner agents, and eliminating copyright liabilities on school media channels.",
  },
  {
    no: "03",
    title: "Systems Over Symptoms: Leadership Under Pressure",
    subtitle: "From 11 Schools to the Executive Suite",
    audience: "Corporate leadership retreats · universities · student-athlete leadership conferences",
    summary:
      "From navigating 11 different schools, coaching award-winning athletic programs, and managing municipal sports complexes: “I don't just build the thing. I build the system around it.”",
  },
];
---

<section id="speaking" class="py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="lead-label text-electricBlue">Speaking &amp; keynotes</p>
      <h2 class="mt-3 text-4xl font-black tracking-tight text-black sm:text-5xl">
        Bring the system to your stage.
      </h2>
      <p class="mt-4 text-lg font-medium text-neutral-600">
        Three signature talks for corporate, sports, and education audiences. Keynote-length or
        breakout, each maps a framework your room can actually use on Monday.
      </p>
    </div>

    <div
      class="mx-auto mt-8 max-w-2xl rounded-sm border border-electricBlue/20 bg-electricBlue/5 px-6 py-4 text-center"
      data-reveal
    >
      <p class="text-[10px] font-black uppercase tracking-[0.18em] text-electricBlue">What you receive</p>
      <p class="mt-2 text-sm font-semibold leading-relaxed text-neutral-700">
        The keynote, delivered live on your stage, backed by the presentation you booked. Every
        booking includes the speaker one-sheet for your planners and press, an optional audience
        Q&amp;A, and (on request) a breakout that runs the framework with your team.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3" data-reveal-group>
      {
        KEYNOTES.map((talk) => (
          <article class="flex flex-col rounded-sm border border-neutral-200 bg-white p-8 transition-all duration-300 hover:border-electricBlue hover:shadow-[0_0_25px_rgba(37,99,235,0.15)]">
            <div class="flex items-center justify-between">
              <span class="rounded-sm bg-electricBlue/10 px-2.5 py-1 text-[10px] font-black tracking-[0.18em] text-electricBlue">
                Keynote {talk.no}
              </span>
            </div>
            <h3 class="mt-5 text-xl font-black leading-snug text-black">{talk.title}</h3>
            <p class="mt-2 text-sm font-bold text-neutral-500">{talk.subtitle}</p>
            <p class="mt-4 text-[11px] font-extrabold uppercase tracking-wide text-neutral-400">{talk.audience}</p>
            <p class="mt-4 text-sm font-medium leading-relaxed text-neutral-700">{talk.summary}</p>
          </article>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 rounded-sm border border-neutral-200 bg-neutral-50 p-6 sm:flex-row sm:items-center sm:justify-between"
      data-reveal
    >
      <p class="flex items-start gap-2 text-sm font-medium text-neutral-700">
        <Icons name="shield-check" className="mt-0.5 h-4 w-4 shrink-0 text-neonRed" />
        Stage content is education and brand strategy. Jaylen is not a licensed sports agent and
        does not solicit athletic contracts.
      </p>
      <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
        <ShinyButton href="/resources/executive-speaker-one-sheet/" className="px-6 py-3 text-xs">
          Speaker one-sheet (PDF)
        </ShinyButton>
        <a
          href="/#contact"
          class="inline-flex items-center justify-center gap-2 rounded-sm bg-black px-6 py-3 text-xs font-black uppercase tracking-wide text-white transition hover:bg-neutral-800"
        >
          Request a quote
          <Icons name="arrow-right" className="h-4 w-4" />
        </a>
      </div>
    </div>
  </div>
</section>