---
import { FLIGHTTIME_URL, SCHEDULING } from "../data/site";
import Icons from "./Icons.astro";
import GlowEffect from "./GlowEffect.astro";
import ShinyButton from "./ShinyButton.astro";

const PATHS = [
  {
    id: "advisory",
    accent: "text-electricBlue",
    ring: "hover:border-electricBlue hover:shadow-[0_0_25px_rgba(37,99,235,0.18)]",
    chip: "bg-electricBlue/10 text-electricBlue",
    icon: "sprout",
    step: "ATHLETE ADVISORY",
    glow: "electric",
    title: "Digital identity, recruiting communication, and athlete brand stewardship.",
    audience: "For student-athletes and families",
    promise: "Control your narrative. I teach the family how.",
    bullets: [
      "Student-athlete digital profile audits across platforms and recruiting systems",
      "Mandatory parental/guardian consent built into every engagement",
      "Recruitment highlight and brand story strategy",
      "Platform lock-in analysis, including Hudl terms",
      "Unified, family-controlled personal IP",
      "Family-owned media assets kept outside proprietary platform lock-in",
      "Positioning that outlasts one season or one platform",
    ],
    deliverables: [
      "Brand & IP Audit: a written findings document of your digital footprint, platform terms, and consent gaps",
      "The Architecture Deck: your strategy translated into one ownable presentation",
      "A family-controlled IP map: every account and asset, and who owns it",
      "A written action plan: prioritized next steps tied directly to the audit",
    ],
    cta: { label: "Schedule Athlete Advisory Call", href: "#contact-brand", external: false },
  },
  {
    id: "clinics",
    accent: "text-neonRed",
    ring: "hover:border-neonRed hover:shadow-[0_0_25px_rgba(239,68,68,0.18)]",
    chip: "bg-neonRed/10 text-neonRed",
    icon: "scale",
    step: "INSTITUTIONAL EDUCATION",
    glow: "neon",
    title: "NIL, media rights, athlete digital identity, and content practices.",
    audience: "For Louisiana high schools, athletic directors, and clubs",
    bullets: [
      "Louisiana Act 810 and LHSAA high school NIL bylaw compliance",
      "SB 389 athlete agent recognition and campus risk",
      "DMCA safe-harbor workflows for highlight content",
      "Master rights versus sync rights in highlight reels",
      "Athletic department media and copyright risk audits",
    ],
    deliverables: [
      "Compliance Risk Audit: a written report of your Act 810 / SB 389 gaps",
      "A student-athlete workbook, parent guide, and coach checklist for the media team",
      "A music-clearance guide: master vs. sync and DMCA safe-harbor workflows for your media team",
      "A 2-hour clinic: delivered on your in-service, admin, or parent day",
      "A yearly refresh offer to keep the program current as rules change",
    ],
    cta: { label: "Inquire for Clinic or Speaking", href: "#contact-clinic", external: false },
  },
  {
    id: "ventures",
    accent: "text-black",
    ring: "hover:border-black hover:shadow-[0_0_25px_rgba(0,0,0,0.15)]",
    chip: "bg-black text-white",
    icon: "building",
    step: "FLIGHTTIME PERFORMANCE",
    glow: "dark",
    title: "Testing, training, team combines, and Flight Night.",
    audience: "Strategic advisory · FlightTime Athletics LLC",
    promise: "Jaylen Sinegal builds the strategy. FlightTime Athletics operates the ecosystem.",
    bullets: [
      "Brand, business, and media strategy for the FlightTime athlete-performance ecosystem",
      "FlightTime operates the academy, testing, and combines - speed and agility training for ages 8 to 17",
      "BlazePod reactive light training and Vital Tanks sled loading on the training floor",
      "Laser-timed combine testing: 40-yard dash, 5-10-5 agility, and vertical jump",
      "AI metric leaderboards for measurable progress",
      "Invitational \"Flight Night\" walkout showcases (a seasonal, invite-only showcase - not a daily service)",
    ],
    deliverables: [
      "Standardized combine metrics: 40-yard dash, 5-10-5 agility, and vertical jump, tracked over time",
      "AI-powered leaderboards so progress is measurable, not just felt",
      "Flight Night as seasonal exposure programming, held on the training floor",
    ],
    cta: { label: "Visit FlightTime Athletics", href: FLIGHTTIME_URL, external: true },
  },
];

const BOOKING_BY_ID: Record<string, string> = { advisory: SCHEDULING.pathA, clinics: SCHEDULING.pathB };

const CONTACT_IDS: Record<string, string> = {
  advisory: "contact-brand",
  clinics: "contact-clinic",
  ventures: "contact-flighttime",
};

const TRACKS = PATHS.map((path) => {
  const booking = BOOKING_BY_ID[path.id] ?? "";
  const isMailTo = typeof booking === "string" && booking.startsWith("mailto:");
  return {
    ...path,
    href: booking || path.cta.href,
    openNewTab: Boolean(booking) && !isMailTo || Boolean(path.cta.external),
    redHover: Boolean(path.cta.external),
  };
});
---

<section id="paths" class="py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="lead-label text-electricBlue">One ecosystem, four business lines</p>
      <h2 class="mt-3 text-4xl font-black tracking-tight text-black sm:text-5xl">
        Choose the entry point that matches your stage.
      </h2>
      <p class="mt-4 text-lg font-medium text-neutral-600">
        Every engagement is strategy plus evidence, compliance, and execution. No generic logos. No
        cookie-cutter playbooks.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3" data-reveal-group>
      {
        TRACKS.map((path) => (
          <Fragment>
            <span id={CONTACT_IDS[path.id]} class="sr-only" aria-hidden="true"></span>
            <article
              id={path.id}
              data-glow-card
              class={`relative flex flex-col rounded-sm border border-neutral-200 bg-white p-8 transition-all duration-300 ${path.ring}`}
            >
            <GlowEffect variant={path.glow} />
            <div class="flex items-center justify-between">
              <span class={`inline-flex items-center gap-1.5 rounded-sm px-2.5 py-1 text-[10px] font-black tracking-[0.18em] ${path.chip}`}>
                <Icons name={path.icon} className="h-3.5 w-3.5" />
                {path.step}
              </span>
            </div>
            <h3 class={`mt-5 text-xl font-black text-black ${path.accent}`}>{path.title}</h3>
            <p class="mt-1 text-xs font-extrabold uppercase tracking-wide text-neutral-500">
              {path.audience}
            </p>

            {path.promise && (
              <p class="mt-3 inline-flex rounded-sm border border-electricBlue/20 bg-electricBlue/5 px-3 py-2 text-xs font-black tracking-wide text-electricBlue">
                {path.promise}
              </p>
            )}

            <ul class="mt-6 flex flex-col gap-3">
              {
                path.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-sm font-medium leading-relaxed text-neutral-700">
                    <Icons name="check-circle" className={`mt-0.5 h-4 w-4 shrink-0 ${path.accent}`} />
                    {bullet}
                  </li>
                ))
              }
            </ul>

            {path.deliverables && (
              <div class="mt-6 rounded-sm border border-neutral-200 bg-neutral-50 p-4">
                <p class="text-[10px] font-black uppercase tracking-[0.18em] text-neutral-500">
                  What you receive
                </p>
                <ul class="mt-3 flex flex-col gap-2.5">
                  {
                    path.deliverables.map((item) => (
                      <li class="flex items-start gap-2 text-xs font-semibold leading-relaxed text-neutral-700">
                        <Icons name="file-badge" className={`mt-0.5 h-3.5 w-3.5 shrink-0 ${path.accent}`} />
                        {item}
                      </li>
                    ))
                  }
                </ul>
              </div>
            )}

            <a
              href={path.href}
              target={path.openNewTab ? "_blank" : undefined}
              rel={path.openNewTab ? "noopener noreferrer" : undefined}
              class={`mt-8 inline-flex items-center gap-2 self-start rounded-sm border border-neutral-300 bg-white px-5 py-3 text-sm font-black uppercase tracking-wide text-black transition-all duration-300 hover:border-electricBlue hover:shadow-[0_0_18px_rgba(37,99,235,0.35)] ${
                path.redHover ? "hover:border-neonRed hover:text-neonRed hover:shadow-[0_0_18px_rgba(239,68,68,0.35)]" : "hover:text-electricBlue"
              }`}
            >
              {path.cta.label}
              <Icons name={path.openNewTab ? "arrow-up-right" : "arrow-right"} />
            </a>
            </article>
          </Fragment>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-3 rounded-sm border border-neutral-200 bg-neutral-50 p-6 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="flex items-center gap-2 text-sm font-medium text-neutral-700">
        <Icons name="file-badge" className="h-4 w-4 text-neonRed" />
        Consulting, education, and media IP work only. Jaylen Sinegal builds the strategy;
        FlightTime Athletics operates the athlete-performance ecosystem. Jaylen is not a licensed
        sports agent and is not an attorney; these services are educational and strategic, not
        legal advice or athlete representation.
      </p>
      <ShinyButton href="/#contact" className="shrink-0 px-6 py-3 text-xs">Start the conversation</ShinyButton>
    </div>
  </div>
</section>