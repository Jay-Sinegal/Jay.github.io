---
import { FLIGHTTIME_URL } from "../data/site";
import Icons from "./Icons.astro";
import GlowEffect from "./GlowEffect.astro";
import ShinyButton from "./ShinyButton.astro";

const PATHS = [
  {
    id: "advisory",
    accent: "text-electricBlue",
    ring: "hover:border-electricBlue hover:shadow-[0_0_25px_rgba(37,99,235,0.18)]",
    chip: "bg-electricBlue/10 text-electricBlue",
    icon: "sprout",
    step: "PATH A",
    glow: "electric",
    title: "Executive Advisory and Brand Architecture",
    audience: "For athletes and families",
    promise: "Control your narrative. I teach the family how.",
    bullets: [
      "Digital profile audits across platforms and recruiting systems",
      "Recruitment highlight and brand story strategy",
      "Platform lock-in analysis, including Hudl terms",
      "Unified, family-controlled personal IP",
      "Positioning that outlasts one season or one platform",
    ],
    cta: { label: "Schedule Brand Strategy Call", href: "#contact-brand", external: false },
  },
  {
    id: "clinics",
    accent: "text-neonRed",
    ring: "hover:border-neonRed hover:shadow-[0_0_25px_rgba(239,68,68,0.18)]",
    chip: "bg-neonRed/10 text-neonRed",
    icon: "scale",
    step: "PATH B",
    glow: "neon",
    title: "Sports Music Licensing and NIL Clinics",
    audience: "For high schools, athletic directors, and clubs",
    bullets: [
      "Louisiana Act 810 and LHSAA bylaw compliance",
      "DMCA safe-harbor workflows for highlight content",
      "Master rights versus sync rights in highlight reels",
      "Athletic department media and copyright risk audits",
    ],
    cta: { label: "Inquire for Clinic or Speaking", href: "#contact-clinic", external: false },
  },
  {
    id: "ventures",
    accent: "text-black",
    ring: "hover:border-black hover:shadow-[0_0_25px_rgba(0,0,0,0.15)]",
    chip: "bg-black text-white",
    icon: "building",
    step: "PATH C",
    glow: "dark",
    title: "Ventures and Incubated Platforms",
    audience: "Case study · FlightTime Athletics LLC",
    bullets: [
      "Youth physiological speed and agility training, ages 8 to 17",
      "BlazePod reactive light training and Vital Tanks sleds on the training floor",
      "Standardized combine testing: 40-yard dash, 5-10-5 agility, vertical jump",
      "AI metric leaderboards for measurable progress",
      'Invitational "Flight Night" walkout showcases',
    ],
    cta: { label: "Visit FlightTime Athletics", href: FLIGHTTIME_URL, external: true },
  },
];
---

<section id="paths" class="py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center" data-reveal>
      <p class="lead-label text-electricBlue">Three paths, one system</p>
      <h2 class="mt-3 text-4xl font-black tracking-tight text-black sm:text-5xl">
        Choose the entry point that matches your stage.
      </h2>
      <p class="mt-4 text-lg font-medium text-neutral-600">
        Every engagement is strategy plus evidence, compliance, and execution. No generic logos. No
        cookie-cutter playbooks.
      </p>
    </div>

    <div class="mt-14 grid gap-6 lg:grid-cols-3" data-reveal-group>
      {
        PATHS.map((path) => (
          <article
            id={path.id}
            data-glow-card
            class={`relative flex flex-col rounded-sm border border-neutral-200 bg-white p-8 transition-all duration-300 ${path.ring}`}
          >
            <GlowEffect variant={path.glow} />
            <div class="flex items-center justify-between">
              <span class={`inline-flex items-center gap-1.5 rounded-sm px-2.5 py-1 text-[10px] font-black tracking-[0.18em] ${path.chip}`}>
                <Icons name={path.icon} className="h-3.5 w-3.5" />
                {path.step}
              </span>
            </div>
            <h3 class={`mt-5 text-xl font-black text-black ${path.accent}`}>{path.title}</h3>
            <p class="mt-1 text-xs font-extrabold uppercase tracking-wide text-neutral-500">
              {path.audience}
            </p>

            {path.promise && (
              <p class="mt-3 inline-flex rounded-sm border border-electricBlue/20 bg-electricBlue/5 px-3 py-2 text-xs font-black tracking-wide text-electricBlue">
                {path.promise}
              </p>
            )}

            <ul class="mt-6 flex flex-col gap-3">
              {
                path.bullets.map((bullet) => (
                  <li class="flex items-start gap-2.5 text-sm font-medium leading-relaxed text-neutral-700">
                    <Icons name="check-circle" className={`mt-0.5 h-4 w-4 shrink-0 ${path.accent}`} />
                    {bullet}
                  </li>
                ))
              }
            </ul>

            <a
              href={path.cta.href}
              target={path.cta.external ? "_blank" : undefined}
              rel={path.cta.external ? "noopener noreferrer" : undefined}
              class={`mt-8 inline-flex items-center gap-2 self-start rounded-sm border border-neutral-300 bg-white px-5 py-3 text-sm font-black uppercase tracking-wide text-black transition-all duration-300 hover:border-electricBlue hover:shadow-[0_0_18px_rgba(37,99,235,0.35)] ${
                path.cta.external ? "hover:border-neonRed hover:text-neonRed hover:shadow-[0_0_18px_rgba(239,68,68,0.35)]" : "hover:text-electricBlue"
              }`}
            >
              {path.cta.label}
              <Icons name={path.cta.external ? "arrow-up-right" : "arrow-right"} />
            </a>
          </article>
        ))
      }
    </div>

    <div class="mt-12 flex flex-col gap-3 rounded-sm border border-neutral-200 bg-neutral-50 p-6 sm:flex-row sm:items-center sm:justify-between" data-reveal>
      <p class="flex items-center gap-2 text-sm font-medium text-neutral-700">
        <Icons name="file-badge" className="h-4 w-4 text-neonRed" />
        Consulting, education, and media IP work only. Jaylen Sinegal is not a licensed sports
        agent.
      </p>
      <ShinyButton href="/#contact" className="shrink-0 px-6 py-3 text-xs">Start the conversation</ShinyButton>
    </div>
  </div>
</section>