---
import Icons from "./Icons.astro";

const BADGES = [
  { text: "Official Louisiana Storyteller (LED)", glow: "badge-blue" },
  { text: "Acadiana Biddy Coach of the Year", glow: "badge-red" },
  { text: "CBO, FlightTime Athletics LLC", glow: "badge-blue" },
  { text: "M.S. Entertainment Business Candidate", glow: "badge-red" },
  { text: "Member, The National Society of Collegiate Scholars", glow: "badge-blue" },
];
---

<section class="relative overflow-hidden px-6 py-24 sm:py-28">
  <div class="mx-auto max-w-5xl text-center" data-hero-animate>
    <div
      class="mx-auto mb-6 h-28 w-28 overflow-hidden rounded-full bg-gradient-to-br from-electricBlue via-white to-neonRed p-[3px] shadow-[0_0_25px_rgba(37,99,235,0.3)]"
    >
      <img
        src="/medallions/storyteller.jpg"
        alt="Jaylen Sinegal, official Louisiana storyteller and brand strategist"
        width="512"
        height="512"
        loading="eager"
        decoding="async"
        class="h-full w-full rounded-full object-cover"
      />
    </div>

    <p class="lead-label mb-6 text-electricBlue drop-shadow-[0_0_8px_rgba(37,99,235,0.4)]">
      Executive Strategist · Media IP Consultant
    </p>

    <h1
      class="text-5xl font-black leading-tight tracking-tighter text-black sm:text-6xl md:text-7xl"
    >
      Initiate Your Athletic or<br class="hidden sm:block" /> Brand Evolution.
    </h1>

    <p class="mx-auto mt-8 max-w-2xl text-lg font-medium leading-relaxed text-neutral-600">
      Architecting modern athlete IP, copyright compliance, and athletic performance ecosystems
      across the Gulf Coast. Strategy plus evidence, compliance, and execution.
    </p>

    <div class="mt-12 flex flex-wrap items-center justify-center gap-3 md:gap-4">
      {
        BADGES.map((badge) => (
          <span class={`badge ${badge.glow}`}>{badge.text}</span>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="#advisory"
        class="inline-flex w-full items-center justify-center gap-2 rounded-sm bg-black px-8 py-4 text-sm font-black uppercase tracking-wide text-white transition-all duration-300 hover:bg-transparent hover:text-black hover:shadow-[0_0_25px_rgba(37,99,235,0.4)] sm:w-auto sm:border sm:border-black"
      >
        Explore Advisory and Clinics
        <Icons name="arrow-right" />
      </a>
      <a
        href="#ventures"
        class="inline-flex w-full items-center justify-center gap-2 rounded-sm border border-neutral-300 bg-white px-8 py-4 text-sm font-black uppercase tracking-wide text-black transition-all duration-300 hover:border-neonRed hover:text-neonRed hover:shadow-[0_0_25px_rgba(239,68,68,0.4)] sm:w-auto"
      >
        View Ventures
        <Icons name="grid" className="h-4 w-4" />
      </a>
    </div>
  </div>
</section>