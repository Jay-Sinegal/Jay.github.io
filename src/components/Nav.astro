---
import { NAV_LINKS, SITE } from "../data/site";
import Icons from "./Icons.astro";
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-neutral-200 bg-white/90 backdrop-blur-md transition-colors"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex flex-col leading-tight" aria-label="Jaylen Sinegal home">
      <span class="text-base font-extrabold uppercase tracking-tight text-black">{SITE.name}</span>
      <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-electricBlue">
        Executive Brand Strategist
      </span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-8 lg:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class="text-sm font-semibold text-neutral-600 transition hover:text-electricBlue"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="#contact"
        class="hidden items-center gap-2 rounded-sm border border-neutral-300 bg-white px-6 py-2.5 text-sm font-bold text-black transition-all duration-300 hover:border-electricBlue hover:shadow-[0_0_15px_rgba(37,99,235,0.5)] sm:inline-flex"
      >
        Book Consultation
        <Icons name="arrow-right" />
      </a>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-sm border border-neutral-300 text-neutral-800 lg:hidden"
        data-mobile-toggle
        aria-expanded="false"
        aria-label="Open menu"
      >
        <Icons name="menu" />
        <Icons name="x" class="hidden h-5 w-5" />
      </button>
    </div>
  </div>

  <div data-mobile-menu class="hidden border-t border-neutral-200 bg-white lg:hidden">
    <nav aria-label="Mobile" class="container-page flex flex-col py-4">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            data-mobile-link
            class="border-b border-neutral-100 py-3 text-sm font-semibold text-neutral-700 transition hover:text-electricBlue"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#contact"
        data-mobile-link
        class="mt-4 inline-flex items-center justify-center gap-2 rounded-sm bg-black px-4 py-3 text-sm font-bold text-white"
      >
        Book Consultation
        <Icons name="arrow-right" />
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header") as HTMLElement;
  const menu = header?.querySelector("[data-mobile-menu]") as HTMLElement | null;
  const toggle = header?.querySelector("[data-mobile-toggle]") as HTMLButtonElement | null;

  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (toggle) {
      const icons = Array.from(toggle.querySelectorAll("svg"));
      icons.forEach((icon) => icon.classList.add("hidden"));
      icons[open ? 1 : 0]?.classList.remove("hidden");
    }
  };

  toggle?.addEventListener("click", () => setOpen(!menu?.classList.contains("hidden")));
  menu?.querySelectorAll("[data-mobile-link]").forEach((link) =>
    link.addEventListener("click", () => setOpen(false))
  );
</script>