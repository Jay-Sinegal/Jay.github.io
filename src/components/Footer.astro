---
import Icons from "./Icons.astro";
import { SITE } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200 bg-white">
  <div class="container-page py-12">
    <div class="grid gap-10 lg:grid-cols-3">
      <div>
        <a href="/" class="flex flex-col leading-tight">
          <span class="text-base font-extrabold uppercase tracking-tight text-black">
            {SITE.name}
          </span>
          <span class="text-[10px] font-bold uppercase tracking-[0.22em] text-electricBlue">
            Executive Brand Strategist
          </span>
        </a>
        <p class="mt-4 max-w-xs text-sm font-medium leading-relaxed text-neutral-600">
          Brand strategy, talent representation alternatives, media IP, and performance ecosystems
          across the Gulf Coast.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400">
          Legal safeguards
        </h3>
        <p class="mt-4 text-sm font-medium leading-relaxed text-neutral-600">
          Jaylen Sinegal provides brand strategy, media education, and IP consulting. He is not a
          licensed sports agent and does not solicit, negotiate, or procure athletic contracts or
          employment.
        </p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
          <a href="/resources/" class="text-sm font-black uppercase tracking-wide text-electricBlue transition hover:text-black">
            Free resources
          </a>
          <a href="/faq.html" class="text-sm font-black uppercase tracking-wide text-electricBlue transition hover:text-black">
            FAQ
          </a>
        </div>
      </div>

      <div>
        <h3 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400">Connect</h3>
        <div class="mt-4">
          <a
            href="https://www.linkedin.com/in/jaylen-sinegal"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile"
            class="inline-flex h-10 w-10 items-center justify-center rounded-sm border border-neutral-300 text-neutral-600 transition hover:border-electricBlue hover:text-electricBlue hover:shadow-[0_0_15px_rgba(37,99,235,0.4)]"
          >
            <Icons name="linkedin" />
          </a>
        </div>
        <p class="mt-4 text-xs font-semibold text-neutral-500">Lafayette · Youngsville · Louisiana</p>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-neutral-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs font-semibold text-neutral-500">© {year} {SITE.name}. All rights reserved.</p>
      <p class="flex items-center gap-2 text-xs font-semibold text-neutral-500">
        <Icons name="zap" className="h-3.5 w-3.5 text-electricBlue" />
        Governance · Compliance · Brand evidence
      </p>
    </div>
  </div>
</footer>