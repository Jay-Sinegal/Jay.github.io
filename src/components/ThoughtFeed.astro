---
import { FEATURED_TITLES, articleBySlug } from "../data/articles";
import Icons from "./Icons.astro";
---

<section id="blog" class="py-24">
  <div class="container-page">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.16em] text-cobalt">
          Thought leadership
        </p>
        <h2 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">
          Published long-form thinking.
        </h2>
      </div>
      <a
        href="/blog/"
        class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-white/70 transition hover:text-white"
      >
        All articles
        <Icons name="arrow-up-right" />
      </a>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        FEATURED_TITLES.map((featured) => {
          const article = articleBySlug(featured.slug);
          if (!article) return null;
          return (
            <a
              href={`/blog/${featured.slug}.html`}
              class="group flex flex-col rounded-xl border border-white/10 bg-steel-900/60 p-7 transition hover:border-white/30"
            >
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-gold">
                {article.pillar}
              </p>
              <h3 class="mt-4 flex-1 text-lg font-bold leading-snug text-white">{featured.title}</h3>
              <p class="mt-4 flex items-center justify-between text-sm text-white/45">
                <span>{article.dateLabel}</span>
                <span class="inline-flex items-center gap-1 text-cobalt transition group-hover:gap-2">
                  Read
                  <Icons name="arrow-up-right" />
                </span>
              </p>
            </a>
          );
        })
      }
    </div>
  </div>
</section>