---
import { FEATURED_TITLES, articleBySlug } from "../data/articles";
import Icons from "./Icons.astro";
---

<section id="blog" class="border-t border-neutral-200 bg-neutral-50 py-24">
  <div class="container-page">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="lead-label text-electricBlue">Thought leadership</p>
        <h2 class="mt-3 text-4xl font-black tracking-tight text-black sm:text-5xl">
          Published long-form thinking.
        </h2>
      </div>
      <a
        href="/blog/"
        class="inline-flex shrink-0 items-center gap-2 text-sm font-black uppercase tracking-wide text-black transition hover:text-electricBlue"
      >
        All articles
        <Icons name="arrow-up-right" />
      </a>
    </div>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        FEATURED_TITLES.map((featured) => {
          const article = articleBySlug(featured.slug);
          if (!article) return null;
          return (
            <a
              href={`/blog/${featured.slug}.html`}
              class="group flex flex-col rounded-sm border border-neutral-200 bg-white p-8 transition-all duration-300 hover:border-electricBlue hover:shadow-[0_0_25px_rgba(37,99,235,0.18)]"
            >
              <p class="text-[11px] font-black uppercase tracking-[0.18em] text-electricBlue">
                {article.pillar}
              </p>
              <h3 class="mt-4 flex-1 text-lg font-black leading-snug text-black">
                {featured.title}
              </h3>
              <p class="mt-4 flex items-center justify-between text-sm font-semibold text-neutral-500">
                <span>{article.dateLabel}</span>
                <span
                  class="inline-flex items-center gap-1 text-electricBlue transition-all group-hover:gap-2 group-hover:text-black"
                >
                  Read
                  <Icons name="arrow-up-right" />
                </span>
              </p>
            </a>
          );
        })
      }
    </div>
  </div>
</section>