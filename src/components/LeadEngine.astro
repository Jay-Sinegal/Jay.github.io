---
import Icons from "./Icons.astro";

const OBJECTIVES = [
  {
    value: "brand-architecture",
    label: "Executive Brand Architecture (1-on-1 Consultation)",
  },
  {
    value: "clinic-school",
    label: "School / Organization NIL and Music Licensing Clinic",
  },
  {
    value: "audit",
    label: "Media Copyright and Facility Audit",
  },
  {
    value: "flighttime",
    label: "FlightTime Athletics Combine and Training Inquiry",
  },
];
---

<section id="contact" class="border-t border-white/5 bg-white/[0.02] py-24">
  <div class="container-page">
    <div class="mx-auto max-w-2xl rounded-2xl border border-white/10 bg-steel-900/70 p-8 sm:p-12">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-cobalt">Lead engine</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Submit a strategic inquiry.
      </h2>
      <p class="mt-3 text-white/60">
        Tell me what you are building. I reply personally, within one business day, from a
        Louisiana area code.
      </p>

      <form
        class="mt-8 flex flex-col gap-5"
        action="https://formspree.io/f/xeaqkdgv"
        method="POST"
      >
        <input type="hidden" name="_subject" value="New strategic inquiry · jaylensinegal.com" />
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

        <div>
          <label for="lead-name" class="mb-2 block text-sm font-semibold text-white/80">Name</label>
          <input
            id="lead-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your full name"
            class="w-full rounded-md border border-white/10 bg-midnight px-4 py-3 text-sm text-white placeholder-white/30 outline-none transition focus:border-cobalt"
          />
        </div>

        <div>
          <label for="lead-email" class="mb-2 block text-sm font-semibold text-white/80">
            Email address
          </label>
          <input
            id="lead-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full rounded-md border border-white/10 bg-midnight px-4 py-3 text-sm text-white placeholder-white/30 outline-none transition focus:border-cobalt"
          />
        </div>

        <div>
          <label for="lead-objective" class="mb-2 block text-sm font-semibold text-white/80">
            Objective
          </label>
          <select
            id="lead-objective"
            name="objective"
            required
            class="w-full rounded-md border border-white/10 bg-midnight px-4 py-3 text-sm text-white outline-none transition focus:border-cobalt"
          >
            <option value="" selected disabled>Select your objective</option>
            {
              OBJECTIVES.map((o) => (
                <option value={o.value}>{o.label}</option>
              ))
            }
          </select>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-md bg-cobalt px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-cobalt/25 transition hover:bg-blue-600"
        >
          Submit Strategic Inquiry
          <Icons name="send" />
        </button>

        <p class="flex items-center gap-2 text-xs text-white/45">
          <Icons name="shield-check" className="h-4 w-4 text-gold" />
          Brand strategy, media education, and IP consulting only. Not a licensed sports agent.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const OBJECTIVE_MAP: Record<string, string> = {
    "#contact-brand": "brand-architecture",
    "#contact-clinic": "clinic-school",
    "#contact-audit": "audit",
    "#contact-flighttime": "flighttime",
  };

  const apply = () => {
    const objective = OBJECTIVE_MAP[window.location.hash];
    if (!objective) return;
    const select = document.getElementById("lead-objective") as HTMLSelectElement | null;
    if (select) select.value = objective;
    document.getElementById("contact")?.scrollIntoView({ behavior: "smooth", block: "start" });
  };
  apply();
  window.addEventListener("hashchange", apply);
</script>