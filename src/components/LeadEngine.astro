---
import Icons from "./Icons.astro";

const OBJECTIVES = [
  {
    value: "brand-architecture",
    label: "Athlete Advisory (1-on-1 brand stewardship)",
  },
  {
    value: "clinic-school",
    label: "Institutional Education (school NIL & music clinic)",
  },
  {
    value: "audit",
    label: "Media Copyright and Facility Audit",
  },
  {
    value: "flighttime",
    label: "FlightTime Performance (combine, training, Flight Night)",
  },
];
---

<section id="contact" class="py-24">
  <div class="container-page">
    <span id="contact-audit" class="sr-only" aria-hidden="true"></span>
    <span id="contact-flighttime" class="sr-only" aria-hidden="true"></span>
    <div class="mx-auto max-w-2xl rounded-sm border-2 border-neutral-200 bg-white p-8 sm:p-12" data-reveal>
      <p class="lead-label text-electricBlue">Lead engine</p>
      <h2 class="mt-3 text-3xl font-black tracking-tight text-black sm:text-4xl">
        Submit a strategic inquiry.
      </h2>
      <p class="mt-3 font-medium text-neutral-600">
        Tell me what you are building. I reply personally, within one business day, from a
        Louisiana area code - with a written read on where you stand and one clear next step.
      </p>

      <p class="mt-4 flex items-start gap-2 rounded-sm border border-neutral-200 bg-neutral-50 p-4 text-xs font-semibold leading-relaxed text-neutral-700">
        <Icons name="file-badge" className="mt-0.5 h-4 w-4 shrink-0 text-electricBlue" />
        <span>
          <span class="font-black uppercase tracking-wide text-neutral-800">What you receive:</span>
          a personal reply, a written read on your situation, the specific deliverable for your
          path, and the exact next step to start. No obligation.
        </span>
      </p>

      <form
        class="mt-8 flex flex-col gap-5"
        action="https://formspree.io/f/xeaqkdgv"
        method="POST"
      >
        <input type="hidden" name="_subject" value="New strategic inquiry · jaylensinegal.com" />
        <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />

        <div>
          <label for="lead-name" class="mb-2 block text-sm font-bold text-neutral-800">Name</label>
          <input
            id="lead-name"
            name="name"
            type="text"
            required
            autocomplete="name"
            placeholder="Your full name"
            class="w-full rounded-sm border border-neutral-300 bg-white px-4 py-3 text-sm font-medium text-black placeholder-neutral-400 outline-none transition focus:border-electricBlue focus:ring-2 focus:ring-electricBlue/20"
          />
        </div>

        <div>
          <label for="lead-email" class="mb-2 block text-sm font-bold text-neutral-800">
            Email address
          </label>
          <input
            id="lead-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full rounded-sm border border-neutral-300 bg-white px-4 py-3 text-sm font-medium text-black placeholder-neutral-400 outline-none transition focus:border-electricBlue focus:ring-2 focus:ring-electricBlue/20"
          />
        </div>

        <div>
          <label for="lead-objective" class="mb-2 block text-sm font-bold text-neutral-800">
            Objective
          </label>
          <select
            id="lead-objective"
            name="objective"
            required
            class="w-full rounded-sm border border-neutral-300 bg-white px-4 py-3 text-sm font-medium text-black outline-none transition focus:border-electricBlue focus:ring-2 focus:ring-electricBlue/20"
          >
            <option value="" selected disabled>Select your objective</option>
            {
              OBJECTIVES.map((o) => (
                <option value={o.value}>{o.label}</option>
              ))
            }
          </select>
        </div>

        <div class="flex flex-col gap-3 rounded-sm border border-neutral-200 bg-neutral-50 p-4 text-xs font-medium leading-relaxed text-neutral-700">
          <label class="flex items-start gap-2">
            <input type="checkbox" name="consent_non_attorney" value="agreed" required class="mt-0.5 h-4 w-4 shrink-0 accent-black" />
            <span>I acknowledge that Jaylen Sinegal is an Executive Brand Strategist, not an attorney or licensed athlete agent (Louisiana SB 389). I understand services are strictly educational and do not include legal representation or contract procurement.</span>
          </label>
          <label class="flex items-start gap-2">
            <input type="checkbox" name="consent_parent_guardian_810" value="agreed" class="mt-0.5 h-4 w-4 shrink-0 accent-black" />
            <span>(If participant is under 18) As parent or legal guardian, I give express written consent for brand advisory consultation in compliance with Louisiana Act 810 minor NIL regulations.</span>
          </label>
          <label class="flex items-start gap-2">
            <input type="checkbox" name="consent_data_ots" value="agreed" required class="mt-0.5 h-4 w-4 shrink-0 accent-black" />
            <span>I acknowledge that all student-athlete data is handled confidentially and evaluated with direct human oversight, adhering to Louisiana OTS ethical data standards.</span>
          </label>
        </div>

        <button
          type="submit"
          class="inline-flex items-center justify-center gap-2 rounded-sm border border-black bg-black px-6 py-4 text-sm font-black uppercase tracking-wide text-white transition-all duration-300 hover:bg-transparent hover:text-neonRed hover:shadow-[0_0_25px_rgba(239,68,68,0.6)]"
        >
          Submit Strategic Inquiry
          <Icons name="send" />
        </button>

        <p class="flex items-center gap-2 text-xs font-semibold text-neutral-500">
          <Icons name="shield-check" className="h-4 w-4 text-neonRed" />
          Brand strategy, media education, and IP consulting only. Jaylen is not a licensed
          sports agent and is not an attorney; nothing on this site is legal advice.
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  const OBJECTIVE_MAP: Record<string, string> = {
    "#contact-brand": "brand-architecture",
    "#contact-clinic": "clinic-school",
    "#contact-audit": "audit",
    "#contact-flighttime": "flighttime",
  };

  const apply = () => {
    const objective = OBJECTIVE_MAP[window.location.hash];
    if (!objective) return;
    const select = document.getElementById("lead-objective") as HTMLSelectElement | null;
    if (select) select.value = objective;
    document.getElementById("contact")?.scrollIntoView({ behavior: "smooth", block: "start" });
  };
  apply();
  window.addEventListener("hashchange", apply);
</script>