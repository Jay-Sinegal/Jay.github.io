---
interface Props {
  href: string;
  className?: string;
  type?: "link" | "submit";
  accent?: "blue" | "red";
}

const { href, className = "", type = "link", accent = "blue" } = Astro.props;
---

{
  type === "link" ? (
    <a
      href={href}
      class={`shiny-button shiny-button--${accent} ${className}`}
    >
      <span class="shiny-button__inner"><slot /></span>
    </a>
  ) : (
    <button type="submit" class={`shiny-button shiny-button--${accent} ${className}`}>
      <span class="shiny-button__inner"><slot /></span>
    </button>
  )
}

<style>
  .shiny-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    overflow: hidden;
    border-radius: 0.125rem;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #ffffff;
    border: 1px solid transparent;
    cursor: pointer;
    isolation: isolate;
    transition: box-shadow 300ms ease;
  }
  .shiny-button--blue {
    background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 55%, #3b82f6 100%);
  }
  .shiny-button--red {
    background: linear-gradient(135deg, #b91c1c 0%, #ef4444 55%, #f87171 100%);
  }
  .shiny-button::before {
    content: "";
    position: absolute;
    inset: -150% -50%;
    z-index: -1;
    background: linear-gradient(
      115deg,
      transparent 20%,
      rgba(255, 255, 255, 0.55) 36%,
      rgba(255, 255, 255, 0.9) 50%,
      rgba(255, 255, 255, 0.55) 64%,
      transparent 80%
    );
    transform: translateX(-70%) skewX(-18deg);
    transition: transform 700ms cubic-bezier(0.2, 0.65, 0.35, 1);
  }
  .shiny-button:hover::before {
    transform: translateX(70%) skewX(-18deg);
  }
  .shiny-button:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
  }
  .shiny-button:hover {
    box-shadow: 0 0 28px rgba(37, 99, 235, 0.45);
  }
  .shiny-button--red:hover {
    box-shadow: 0 0 28px rgba(239, 68, 68, 0.45);
  }
  @media (prefers-reduced-motion: reduce) {
    .shiny-button::before {
      transition: none;
    }
  }
</style>