---
interface Props {
  className?: string;
  blur?: number;
  radius?: number;
}

const { className = "", blur = 45, radius = 240 } = Astro.props;
---

<div class={`backlight ${className}`}>
  <div class="backlight__glow" aria-hidden="true"></div>
  <div class="backlight__border" aria-hidden="true"></div>
  <div class="backlight__content"><slot /></div>
</div>

<style>
  .backlight {
    position: relative;
    overflow: hidden;
    border-radius: 0.25rem;
  }
  .backlight__glow {
    position: absolute;
    left: calc(var(--bl-x, 50%) - var(--bl-radius, 240px));
    top: calc(var(--bl-y, 50%) - var(--bl-radius, 240px));
    width: calc(var(--bl-radius, 240px) * 2);
    height: calc(var(--bl-radius, 240px) * 2);
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      rgba(37, 99, 235, 0.18) 0%,
      rgba(239, 68, 68, 0.12) 45%,
      transparent 70%
    );
    filter: blur(var(--bl-blur, 45px));
    pointer-events: none;
    transition: opacity 500ms ease;
    opacity: 0.7;
    z-index: 0;
  }
  .backlight__border {
    position: absolute;
    inset: 0;
    z-index: 1;
    border: 1px solid rgba(37, 99, 235, 0.15);
    border-radius: 0.25rem;
    pointer-events: none;
  }
  .backlight__content {
    position: relative;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .backlight__glow {
      opacity: 0.35;
    }
  }
</style>

<script>
  (() => {
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    document.querySelectorAll<HTMLElement>(".backlight").forEach((el) => {
      const glow = el.querySelector<HTMLElement>("[class*=glow]");
      if (!glow) return;

      const set = (x: number, y: number) => {
        const rect = el.getBoundingClientRect();
        el.style.setProperty("--bl-x", `${x - rect.left}px`);
        el.style.setProperty("--bl-y", `${y - rect.top}px`);
      };

      el.addEventListener("pointermove", (event: PointerEvent) => set(event.clientX, event.clientY));
      if (reducedMotion) {
        el.style.setProperty("--bl-x", "50%");
        el.style.setProperty("--bl-y", "50%");
      }
    });
  })();
</script>