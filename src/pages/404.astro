---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icons from "../components/Icons.astro";
---

<Base
  title="Page Not Found | Jaylen Sinegal"
  description="This page could not be found on jaylensinegal.com. Head back to the homepage to explore Jaylen Sinegal's brand strategy work and blog."
  canonical="/404.html"
>
  <Nav />
  <main class="flex min-h-[70vh] items-center justify-center pb-24 pt-20">
    <div class="container-page max-w-xl text-center">
      <p class="lead-label text-electricBlue">Error 404</p>
      <h1 class="mt-4 text-4xl font-black tracking-tight text-black sm:text-5xl">
        This page took a wrong turn.
      </h1>
      <p class="mt-4 text-lg font-medium text-neutral-600">
        The page you tried to reach does not exist or has been moved. Every path in my brand is
        intentional, so this one deserves a redirect.
      </p>
      <div class="mt-8 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-sm border border-black bg-black px-6 py-4 text-sm font-black uppercase tracking-wide text-white transition-all duration-300 hover:bg-transparent hover:text-neonRed hover:shadow-[0_0_25px_rgba(239,68,68,0.6)]"
        >
          <Icons name="arrow-right" />
          Back to Homepage
        </a>
        <a
          href="/blog/"
          class="inline-flex items-center justify-center gap-2 rounded-sm border border-neutral-300 bg-white px-6 py-4 text-sm font-black uppercase tracking-wide text-black transition-all duration-300 hover:border-electricBlue hover:text-electricBlue hover:shadow-[0_0_20px_rgba(37,99,235,0.4)]"
        >
          Read the Blog
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Base>