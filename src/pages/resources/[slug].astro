---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Icons from "../../components/Icons.astro";
import resources from "../../data/resources.json";

interface Props {
  slug: string;
}

export function getStaticPaths() {
  return (resources as { slug: string }[]).map((r) => ({
    params: { slug: r.slug },
    props: { slug: r.slug },
  }));
}

const { slug } = Astro.props as Props;
const resource = (resources as any[]).find((r) => r.slug === slug);
if (!resource) throw new Error(`Unknown resource slug: ${slug}`);

const pageUrl = `https://jaylensinegal.com/resources/${resource.slug}/`;
const fileUrl = `https://jaylensinegal.com/downloads/${resource.pdf}`;

const creativeSchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  "@id": `${pageUrl}#resource`,
  name: resource.title,
  description: resource.description,
  url: pageUrl,
  inLanguage: "en-US",
  creativeWorkStatus: "Published",
  isAccessibleForFree: true,
  author: { "@id": "https://jaylensinegal.com/#person" },
  provider: { "@id": "https://jaylensinegal.com/#person" },
  encoding: {
    "@type": "MediaObject",
    encodingFormat: "application/pdf",
    contentUrl: fileUrl,
  },
};
---

<Base
  title={`${resource.title} | Jaylen Sinegal`}
  description={resource.description}
  canonical={`/resources/${resource.slug}/`}
>
  <Nav />
  <main>
    <section class="py-20 sm:py-28">
      <div class="container-page">
        <a href="/resources/" class="inline-flex items-center gap-2 text-sm font-bold text-neutral-500 transition hover:text-electricBlue">
          <Icons name="arrow-left" className="h-4 w-4" />
          Back to free resources
        </a>

        <div class="mt-8 max-w-3xl" data-hero-animate>
          <span class="inline-flex items-center gap-1.5 rounded-sm bg-electricBlue/10 px-2.5 py-1 text-[10px] font-black tracking-[0.18em] text-electricBlue">
            <Icons name="file-badge" className="h-3.5 w-3.5" />
            {resource.category}
          </span>
          <h1 class="mt-4 text-4xl font-black tracking-tight text-black sm:text-5xl">
            {resource.title}
          </h1>
          <p class="mt-3 text-lg font-semibold text-neutral-500">{resource.tagline}</p>
        </div>

        <div class="mt-10 grid gap-10 lg:grid-cols-[1fr_320px]" data-reveal>
          <div class="max-w-3xl">
            <p class="text-lg font-medium leading-relaxed text-neutral-700">{resource.intro}</p>

            <ul class="mt-8 flex flex-col gap-4 border-t border-neutral-200 pt-8">
              {resource.bullets.map((bullet: string) => (
                <li class="flex items-start gap-3 text-base font-medium leading-relaxed text-neutral-700">
                  <Icons name="check-circle" className="mt-0.5 h-5 w-5 shrink-0 text-electricBlue" />
                  {bullet}
                </li>
              ))}
            </ul>

            <div class="mt-10 flex flex-col gap-3 rounded-sm border border-neutral-200 bg-neutral-50 p-6 sm:flex-row sm:items-center sm:justify-between">
              <p class="flex items-start gap-2 text-sm font-medium text-neutral-700">
                <Icons name="shield-check" className="mt-0.5 h-4 w-4 shrink-0 text-neonRed" />
                Educational resource only, not legal advice. Jaylen Sinegal provides brand strategy,
                media education, and IP consulting; he is not a licensed sports agent.
              </p>
            </div>
          </div>

          <aside class="lg:sticky lg:top-24 lg:self-start">
            <div class="rounded-sm border border-neutral-200 bg-white p-7">
              <p class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400">
                Download the PDF
              </p>
              <a
                href={`/downloads/${resource.pdf}`}
                download
                class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-sm bg-black px-6 py-4 text-sm font-black uppercase tracking-wide text-white transition-all duration-300 hover:bg-neutral-800"
              >
                <Icons name="download" className="h-4 w-4" />
                Save PDF
              </a>
              <p class="mt-4 text-xs font-semibold leading-relaxed text-neutral-500">
                {resource.audience}
              </p>
              <div class="mt-6 border-t border-neutral-200 pt-6">
                <a
                  href="/#contact"
                  class="inline-flex items-center gap-2 text-sm font-black uppercase tracking-wide text-electricBlue transition hover:text-black"
                >
                  Not sure where you fit?
                  <Icons name="arrow-up-right" className="h-4 w-4" />
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(creativeSchema)} />
  <Footer />
</Base>