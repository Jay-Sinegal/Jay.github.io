---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Icons from "../../components/Icons.astro";
import resources from "../../data/resources.json";

const categories = [...new Set((resources as { category: string }[]).map((r) => r.category))];
---

<Base
  title="Free Resources, Checklists & Templates | Jaylen Sinegal"
  description="Free downloadable checklists, one-pagers, and templates for athletes, families, schools, and creators: NIL consent, agent verification, music rights, and more."
  canonical="/resources/"
>
  <Nav />
  <main>
    <section id="resources-top" class="py-20 sm:py-28">
      <div class="container-page">
        <div class="mx-auto max-w-2xl" data-hero-animate>
          <p class="lead-label text-electricBlue">Free resource library</p>
          <h1 class="mt-3 text-4xl font-black tracking-tight text-black sm:text-5xl">
            Download the toolkit.
          </h1>
          <p class="mt-4 text-lg font-medium text-neutral-600">
            Practical checklists, one-pagers, and templates for athletes, families, schools, and
            creators. No email gate, no obligation. Education and media IP guidance only - not legal
            advice, not athlete representation.
          </p>
        </div>

        {
          categories.map((category) => (
            <div class="mt-14" data-reveal>
              <h2 class="text-xs font-black uppercase tracking-[0.2em] text-neutral-400">
                {category}
              </h2>
              <div class="mt-5 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {(resources as { category: string }[])
                  .filter((r) => r.category === category)
                  .map((r) => (
                    <article
                      class="group relative flex flex-col rounded-sm border border-neutral-200 bg-white p-7 transition-all duration-300 hover:border-electricBlue hover:shadow-[0_0_25px_rgba(37,99,235,0.15)]"
                    >
                      <a href={`/resources/${r.slug}/`} class="absolute inset-0" aria-label={r.title} />
                      <div class="relative">
                        <span class="inline-flex items-center gap-1.5 rounded-sm bg-electricBlue/10 px-2.5 py-1 text-[10px] font-black tracking-[0.18em] text-electricBlue">
                          <Icons name="file-badge" className="h-3.5 w-3.5" />
                          PDF
                        </span>
                        <h3 class="mt-4 text-lg font-black text-black">{r.title}</h3>
                        <p class="mt-2 text-sm font-medium leading-relaxed text-neutral-600">{r.tagline}</p>
                        <a
                          href={`/downloads/${r.pdf}`}
                          download
                          class="pointer-events-auto relative mt-5 inline-flex items-center gap-2 text-sm font-black uppercase tracking-wide text-electricBlue transition group-hover:text-black"
                        >
                          Download
                          <Icons name="download" className="h-4 w-4" />
                        </a>
                      </div>
                    </article>
                  ))}
              </div>
            </div>
          ))
        }

        <div
          class="mt-16 flex flex-col gap-3 rounded-sm border border-neutral-200 bg-neutral-50 p-7 sm:flex-row sm:items-center sm:justify-between"
          data-reveal
        >
          <p class="flex items-start gap-2 text-sm font-medium text-neutral-700">
            <Icons name="shield-check" className="mt-0.5 h-4 w-4 shrink-0 text-neonRed" />
            Every resource is educational. If your situation involves real money, contracts, or a
            minor, have a qualified attorney review the final documents.
          </p>
          <a
            href="/#contact"
            class="inline-flex shrink-0 items-center justify-center gap-2 rounded-sm bg-black px-6 py-3 text-xs font-black uppercase tracking-wide text-white transition hover:bg-neutral-800"
          >
            Start the conversation
            <Icons name="arrow-right" className="h-4 w-4" />
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>