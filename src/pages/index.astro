---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import PolicyBand from "../components/PolicyBand.astro";
import About from "../components/About.astro";
import TrackMatrix from "../components/TrackMatrix.astro";
import ThoughtFeed from "../components/ThoughtFeed.astro";
import Speaking from "../components/Speaking.astro";
import LeadEngine from "../components/LeadEngine.astro";
import BookingCalendar from "../components/BookingCalendar.astro";
import Footer from "../components/Footer.astro";
import { ARTICLES } from "../data/articles";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": "https://jaylensinegal.com/#service",
  name: "Executive Brand Strategy and Media IP Consulting",
  description:
    "Education and consulting only: athlete and family brand architecture (Athlete Advisory), sports music licensing and NIL clinics for schools (Institutional Education), and media copyright and facility audits. Jaylen Sinegal is not a licensed sports agent and does not solicit, negotiate, or procure athletic contracts or employment.",
  serviceType: "Consulting",
  category: ["Brand Strategy", "NIL Education", "Music Licensing Education", "Copyright Compliance", "Media Audit"],
  provider: { "@id": "https://jaylensinegal.com/#person" },
  areaServed: ["Lafayette", "Louisiana", "Gulf Coast", "United States"],
  audience: {
    "@type": "EducationalAudience",
    educationalRole: "Families, student-athletes, schools, athletic departments, and creative professionals",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Business lines",
    itemListElement: [
      { "@type": "Offer", name: "Athlete Advisory", category: "Education" },
      { "@type": "Offer", name: "Institutional Education", category: "Education" },
      { "@type": "Offer", name: "FlightTime Performance", category: "Consulting" },
    ],
  },
};

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://jaylensinegal.com/#blog",
  url: "https://jaylensinegal.com/blog/",
  name: "Jaylen Sinegal Blog",
  description:
    "Long-form brand strategy, media IP, and sports entertainment thinking from Jaylen Sinegal.",
  blogPost: ARTICLES.map((a) => ({
    "@type": "BlogPosting",
    headline: a.title,
    url: `https://jaylensinegal.com/blog/${a.slug}.html`,
    datePublished: a.date,
    author: { "@id": "https://jaylensinegal.com/#person" },
  })),
};
---

<Base
  title="Jaylen Sinegal | Executive Brand Strategist and Media IP Consultant"
  description="Jaylen Sinegal is an executive brand strategist and media IP consultant across Louisiana. Athlete IP, copyright compliance, and athletic performance ecosystems for athletes, schools, brands, and communities."
  canonical="/"
>
  <Nav />
  <main>
    <Hero />
    <PolicyBand />
    <About />
    <TrackMatrix />
    <Speaking />
    <ThoughtFeed />
    <LeadEngine />
    <BookingCalendar />
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
</Base>