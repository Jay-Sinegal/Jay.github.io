---
import "../styles/globals.css";
import JsonLd from "../components/JsonLd.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  extraCanonical?: string;
}

const {
  title,
  description,
  canonical,
  ogType = "website",
  ogImage = "https://jaylensinegal.com/louisiana-storyteller.jpg",
  ogImageAlt = "Jaylen Sinegal, executive brand strategist and Louisiana storyteller",
  extraCanonical = "",
} = Astro.props;

const host = "https://jaylensinegal.com";
const fullCanonical = canonical.startsWith("http") ? canonical : `${host}${canonical}`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="alternate" type="application/rss+xml" title="Jaylen Sinegal Blog" href="/rss.xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <link rel="canonical" href={fullCanonical} />
    {extraCanonical && <link rel="alternate" hreflang="en" href={fullCanonical} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Jaylen Sinegal" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2000" />
    <meta property="og:image:height" content="2000" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://www.googletagmanager.com" />

    <script>
      try { if (localStorage.getItem('jaylen_ga4_opt_out') === 'true') window['ga-disable-G-V09SKB92BX'] = true; } catch (error) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-V09SKB92BX"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-V09SKB92BX', { anonymize_ip: true });
    </script>

    <JsonLd />
  </head>
  <body>
    <slot />
    <script is:inline>
      document.addEventListener("submit", function (event) {
        var target = event.target;
        var form = target && target.closest ? target.closest(".download-gate") : null;
        if (!form) return;
        event.preventDefault();

        var emailEl = form.querySelector('input[name="email"]');
        var spoofEl = form.querySelector('input[name="_company"]');
        var email = emailEl ? emailEl.value : "";
        if (spoofEl && spoofEl.value) return; // bots fill the honeypot

        var fileUrl = form.getAttribute("data-resource-url") || "";
        var captureUrl = form.getAttribute("data-capture-url") || "";

        function swap(text) {
          var btn = form.querySelector("button[type='submit']");
          if (btn) btn.textContent = text;
          var old = form.querySelector(".download-gate-note");
          if (old && old.parentNode) old.parentNode.removeChild(old);
          var note = document.createElement("p");
          note.className = "download-gate-note mt-3 text-[11px] font-bold leading-relaxed text-neutral-600";
          note.textContent = text;
          form.appendChild(note);
        }

        function triggerDownload() {
          var link = document.createElement("a");
          link.href = fileUrl;
          link.download = "";
          document.body.appendChild(link);
          link.click();
          link.parentNode.removeChild(link);
        }

        function done() {
          swap("Check your inbox - downloading now.");
          try {
            if (typeof window.gtag === "function") {
              window.gtag("event", "file_download", {
                file_name: form.getAttribute("data-resource-pdf") || "",
                file_extension: "pdf",
              });
            }
          } catch (err) {}
          triggerDownload();
        }

        if (captureUrl) {
          var timedOut = false;
          var timer = setTimeout(function () { timedOut = true; done(); }, 4000);
          fetch(captureUrl, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              resource: form.getAttribute("data-resource-slug") || "",
              resourceTitle: form.getAttribute("data-resource-title") || "",
              email: email,
              consent: true,
              ts: new Date().toISOString(),
            }),
          })
            .then(function () { clearTimeout(timer); done(); })
            .catch(function () {
              if (!timedOut) { clearTimeout(timer); done(); }
            });
        } else {
          done();
        }
      });

      document.addEventListener("click", function (clickEvent) {
        var el = clickEvent.target && clickEvent.target.closest
          ? clickEvent.target.closest("[data-download-event]")
          : null;
        if (!el || typeof window.gtag !== "function") return;
        try {
          var file = el.getAttribute("data-file-name") || "";
          window.gtag("event", "file_download", {
            file_name: file,
            file_extension: (file.split(".").pop() || "").toLowerCase(),
          });
        } catch (err) {}
      });
    </script>
  </body>
  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduceMotion) {
      ScrollTrigger.config({ ignoreMobileResize: true });

      const hero = document.querySelector("[data-hero-animate]");
      if (hero) {
        gsap.fromTo(
          hero.children,
          { y: 24 },
          { y: 0, autoAlpha: 1, duration: 0.8, ease: "power3.out", stagger: 0.1, delay: 0.15 },
        );
      }

      gsap.utils.toArray<HTMLElement>("[data-reveal]").forEach((el) => {
        gsap.fromTo(
          el,
          { y: 24 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            scrollTrigger: { trigger: el, start: "top 85%", once: true },
          },
        );
      });

      gsap.utils.toArray<HTMLElement>("[data-reveal-group]").forEach((group) => {
        gsap.fromTo(
          group.children,
          { y: 24 },
          {
            y: 0,
            autoAlpha: 1,
            duration: 0.7,
            ease: "power2.out",
            stagger: 0.1,
            scrollTrigger: { trigger: group, start: "top 85%", once: true },
          },
        );
      });

      document.fonts?.ready.then(() => ScrollTrigger.refresh()).catch(() => {});
    }
  </script>
</html>